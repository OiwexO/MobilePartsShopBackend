Samsung Galaxy S22 Replacement Battery
--WebAppBoundary
Content-Disposition: form-data; name="specifications"

3700mAh, 3.88V, Li-ion
--WebAppBoundary
Content-Disposition: form-data; name="manufacturerId"

1
--WebAppBoundary
Content-Disposition: form-data; name="deviceTypeId"

3
--WebAppBoundary
Content-Disposition: form-data; name="partTypeId"

2
--WebAppBoundary
Content-Disposition: form-data; name="deviceModels"

SM-S901B,SM-S901U
--WebAppBoundary
Content-Disposition: form-data; name="partImage"; filename="battery01.jpg"
Content-Type: image/jpeg

