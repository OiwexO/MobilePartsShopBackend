Content-Disposition: form-data; name="price"

950.00
--WebAppBoundary
Content-Disposition: form-data; name="quantity"

45
--WebAppBoundary
Content-Disposition: form-data; name="name"

Apple iPhone 14 Pro Max Taptic Engine
--WebAppBoundary
Content-Disposition: form-data; name="specifications"

Linear haptic feedback vibrator module
--WebAppBoundary
Content-Disposition: form-data; name="manufacturerId"

2
--WebAppBoundary
Content-Disposition: form-data; name="deviceTypeId"

3
--WebAppBoundary
Content-Disposition: form-data; name="partTypeId"

10
--WebAppBoundary
Content-Disposition: form-data; name="deviceModels"

A2849,A2651
--WebAppBoundary
Content-Disposition: form-data; name="partImage"; filename="vibration_motor01.jpg"
Content-Type: image/jpeg

< ./assets/part_image/vibration_motor01.jpg

--WebAppBoundary--

